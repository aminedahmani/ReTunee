    "Each tap reveals the next light. Anxiety, Anger, and Disappointment slow down. Sadness gently speeds up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each tap reveals the next light. Anxiety, Anger, and Disappointment slow down. Sadness gently speeds up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Antippen enthüllt das nächste Licht. Angst, Wut und Enttäuschung verlangsamen sich. Traurigkeit wird sanft schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque revela la siguiente luz. La Ansiedad, la Ira y la Decepción se ralentizan. La Tristeza se acelera suavemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque toucher révèle la lumière suivante. L’anxiété, la colère et la déception ralentissent. La tristesse s’accélère doucement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tocco rivela la luce successiva. Ansia, Rabbia e Delusione rallentano. La Tristezza accelera delicatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするたびに次の光が現れます。不安、怒り、失望はゆっくりと落ち着き、悲しみは穏やかにテンポを上げていきます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toque revela a próxima luz. Ansiedade, Raiva e Decepção desaceleram. A Tristeza acelera suavemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次轻触都会点亮下一束光。焦虑、愤怒和失望会慢下来；悲伤则会温柔地提速。"
          }
        }
      }
    },
