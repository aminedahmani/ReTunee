    "Pause to adjust volume. Choose “I feel better” whenever you want to finish.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause to adjust volume. Choose “I feel better” whenever you want to finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiere, um die Lautstärke anzupassen. Wähle „Mir geht es besser“, wenn du beenden möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa para ajustar el volumen. Elige “Me siento mejor” cuando quieras terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez en pause pour régler le volume. Choisissez « Je me sens mieux » dès que vous voulez terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa per regolare il volume. Scegli “Mi sento meglio” quando desideri concludere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止して音量を調節できます。終了したいときはいつでも「気分が良くなりました」を選択してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause para ajustar o volume. Escolha “Estou me sentindo melhor” quando quiser terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停以调节音量。当你想结束时，随时选择“我感觉好多了”。"
          }
        }
      }
    },
